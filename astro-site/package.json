{
  "name": "alex-roh-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro sync && astro-check",
    "test": "node --test tests/*.test.mjs",
    "predev": "node scripts/sync-assets.mjs && node scripts/build-cms.mjs",
