---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import Pagination from './Pagination.astro';
import type { PostPage } from '../lib/pagination';
interface Props { page: PostPage; }
const { page } = Astro.props;
---
<Base title={page.currentPage > 1 ? `글 · ${page.currentPage}페이지` : undefined}>
  <div class="container">
    <header class="page-heading"><p class="eyebrow">NOTES & IDEAS</p><h1>배우고, 만들고, 기록합니다.</h1><p>개발하며 배운 것과 다시 찾아보고 싶은 생각들.</p></header>
    <div class="section-label">모든 글 <span>{page.total}</span></div>
    <PostList posts={page.posts} />
    <Pagination currentPage={page.currentPage} totalPages={page.totalPages} />
  </div>
</Base>
