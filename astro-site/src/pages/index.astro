---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { allPosts } from '../lib/posts';
const posts = await allPosts();
---
<Base><div class="container"><header class="page-heading"><p class="eyebrow">NOTES & IDEAS</p><h1>배우고, 만들고, 기록합니다.</h1><p>개발하며 배운 것과 다시 찾아보고 싶은 생각들.</p></header><div class="section-label">모든 글 <span>{posts.length}</span></div><PostList posts={posts} /></div></Base>
