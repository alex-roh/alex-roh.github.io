---
import HomeFeed from '../../components/HomeFeed.astro';
import { allPosts } from '../../lib/posts';
import { postPages } from '../../lib/pagination';
export async function getStaticPaths() {
  return postPages(await allPosts()).slice(1).map(page => ({ params: { page: String(page.currentPage) }, props: { page } }));
}
const { page } = Astro.props;
---
<HomeFeed page={page} />
