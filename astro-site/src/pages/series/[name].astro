---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { allPosts, seriesSlug, seriesPosts } from '../../lib/posts';
export async function getStaticPaths() {
 const posts = await allPosts();
 return [...new Set(posts.map(p => p.data.series).filter((x): x is string => !!x))].map(name => ({params:{name:seriesSlug(name)},props:{name,posts:seriesPosts(posts,name)}}));
}
const { name, posts } = Astro.props;
---
<Base title={name}><div class="container"><header class="page-heading"><p class="eyebrow">SERIES · {posts.length} POSTS</p><h1>{name}</h1></header><PostList posts={posts} /></div></Base>
