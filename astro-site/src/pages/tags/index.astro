---
import Base from '../../layouts/Base.astro';
import { allPosts, tagHref } from '../../lib/posts';
const posts = await allPosts();
const tags = [...new Set(posts.flatMap(p => p.data.tags))].sort((a,b) => a.localeCompare(b));
---
<Base title="태그"><div class="container"><header class="page-heading"><p class="eyebrow">TOPICS</p><h1>태그</h1><p>관심 있는 주제로 글을 찾아보세요.</p></header><div class="tag-cloud">{tags.map(tag => <a href={tagHref(tag)}>#{tag}<span>{posts.filter(p => p.data.tags.includes(tag)).length}</span></a>)}</div></div>
<script>
 import { href } from '../../lib/urls';
 const tag = new URLSearchParams(location.search).get('q');
 if (tag) location.replace(href(`tags/${encodeURIComponent(tag)}/`));
</script>
</Base>
